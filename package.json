{
  "name": "franchisehq",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "FranchiseHQ league-management platform",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check": "node tools/run-quality.mjs",
    "check:strict": "node tools/run-quality.mjs --strict",
    "check:syntax": "node tools/check-syntax.mjs",
    "check:lint": "node tools/check-repository.mjs",
    "check:assets": "node tools/check-html-assets.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "check:environments": "node tools/check-environment-contract.mjs",
    "check:migrations": "node tools/check-migrations.mjs",
    "check:migrations:strict": "node tools/check-migrations.mjs --strict",
    "check:release": "node tools/check-release.mjs",
    "inventory": "node tools/generate-inventory.mjs",
    "inventory:verify": "node tools/generate-inventory.mjs --verify",
    "test": "node --test tests/tooling/environment.test.mjs tests/tooling/routes.test.mjs",
    "ci": "node tools/run-quality.mjs"
  }
}
