{
  // Cloudflare Git build root: /workers/franchise-import-worker/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "franchise-hq-import-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 120000
  },
  "workflows": [
    {
      "name": "franchise-hq-import-workflow",
      "binding": "FRANCHISE_IMPORT_WORKFLOW",
      "class_name": "FranchiseImportWorkflow"
    },
    {
      "name": "franchise-hq-schedule-workflow",
      "binding": "FRANCHISE_SCHEDULE_WORKFLOW",
      "class_name": "FranchiseScheduleWorkflow"
    }
  ]
}
