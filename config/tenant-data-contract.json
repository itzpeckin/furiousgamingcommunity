{
  "schemaVersion": 1,
  "release": "8.1.0",
  "resolution": {
    "source": "server",
    "requiresExplicitSlug": true,
    "allowsFirstRowFallback": false,
    "allowsProductHardCodedTenant": false,
    "aliasesAreDatabaseRecords": true,
    "requiredStatuses": {
      "tenantStatus": "enabled",
      "publicStatus": "active"
    }
  },
  "globalTables": [
    "authentication_rate_limits",
    "leagues",
    "oauth_states",
    "platform_league_onboarding_events",
    "platform_league_onboarding_plans",
    "user_auth_identities",
    "schema_migrations",
    "session_security_events",
    "sessions",
    "user_stream_profiles",
    "users",
    "platform_beta_invitations",
    "platform_beta_redemptions",
    "account_action_tokens",
    "account_email_throttles"
  ],
  "featurePolicy": {
    "unknownFeatureEnabled": false,
    "configurationAuthority": "league_features"
  },
  "storagePolicy": {
    "serverNamespaceTemplate": "tenant:{leagueId}:{namespace}",
    "browserStorageAuthority": "ui-preferences-only"
  },
  "auditPolicy": {
    "requiredContext": [
      "leagueId",
      "actorUserId",
      "requestId",
      "actionId",
      "action"
    ]
  },
  "production": {
    "enabledTenantCount": 1,
    "firstTenant": "Furious Gaming Community"
  }
}
